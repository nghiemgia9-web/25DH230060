            <b>FREESHIP XTRA</b>
        </div>

        <div class="header-main">

            <div class="logo">
                TIKI
                <small>Tốt & Nhanh</small>
            </div>

            <div class="search-area">

                <div class="search-box">

                    <span class="search-icon">⌕</span>

                    <input id="searchInput"
                           type="text"
                           placeholder="Tìm kiếm sản phẩm..." />

                    <button id="searchBtn">
                        Tìm kiếm
                    </button>

                </div>

                <div class="keywords">
                    <span>điện gia dụng</span>
                    <span>xe cộ</span>
                    <span>mẹ & bé</span>
                    <span>khỏe đẹp</span>
                    <span>nhà cửa</span>
                    <span>sách</span>
                    <span>thể thao</span>
                    <span>iphone 13</span>
                    <span>điện thoại</span>
                    <span>ipad air 5</span>
                    <span>oppo a17k</span>
                </div>

            </div>

            <div class="header-right">

                <a href="#">
                    🏠 Trang chủ
                </a>

                <a href="#">
                    👤 Tài khoản
                </a>

                <a href="#" class="cart">
                    🛒 Giỏ hàng
                    <b>0</b>
                </a>

            </div>

        </div>


        <div class="commit-bar">

            <span class="commit-title">Cam kết</span>

            <span>🛡 100% hàng thật</span>

            <span>↩ Hoàn 200% nếu hàng giả</span>

            <span>🔄 30 ngày đổi trả</span>

            <span>🚚 Giao nhanh 2h</span>

            <span>🏷 Giá siêu rẻ</span>

            <span>🚚 Freeship mọi đơn</span>

            <span class="address">
                📍 Giao đến:
                <b>Q.1, P. Bến Nghé, Hồ Chí Minh</b>
            </span>

        </div>

    </header>


    <!-- ================= PAGE ================= -->

    <div class="page">

        <div class="breadcrumb">

            <span>Trang chủ</span>

            <b>›</b>

            <span>Điện Thoại - Máy Tính Bảng</span>

        </div>


        <div class="layout">


            <!-- ================= SIDEBAR ================= -->

            <aside class="sidebar">

                <div class="side-box">

                    <h3>Khám phá theo danh mục</h3>

                    <a href="#">
                        Điện thoại Smartphone
                        <b>›</b>
                    </a>

                    <a href="#">
                        Máy tính bảng
                        <b>›</b>
                    </a>

                    <a href="#">
                        Máy đọc sách
                        <b>›</b>
                    </a>

                    <a href="#">
                        Điện thoại phổ thông
                        <b>›</b>
                    </a>

                    <a href="#">
                        Điện thoại bàn
                        <b>›</b>
                    </a>

                </div>


                <!-- SẢN PHẨM TÀI TRỢ -->

                <div class="sponsor-card">

                    <div class="sponsor-label">
                        Tài trợ
                    </div>

                    <div class="side-image">

                        <!-- DÁN LINK ẢNH CỦA BRO VÀO src -->
                        <img src="LINK_ANH_TAI_TRO_1"
                             alt="iPhone 16 Pro Max" />

                    </div>

                    <div class="trading">
                        <b>TIKI</b> Tiki Trading
                    </div>

                    <h4>
                        Apple iPhone 16 Pro Max -
                        Titan Tự Nhiên - 512GB
                    </h4>

                    <div class="stars">
                        ★★★★★
                        <span>Đã bán 95</span>
                    </div>

                    <strong class="side-price">
                        40.990.000 ₫
                    </strong>

                    <button class="blue-button">
                        Xem thêm
                    </button>

                </div>


                <div class="sponsor-card">

                    <div class="sponsor-label">
                        Tài trợ
                    </div>

                    <div class="side-image">

                        <img src="LINK_ANH_TAI_TRO_2"
                             alt="iPhone 16 Pro" />

                    </div>

                    <div class="trading">
                        <b>TIKI</b> Tiki Trading
                    </div>

                    <h4>
                        Apple iPhone 16 Pro -
                        Titan Tự Nhiên - 128GB
                    </h4>

                    <div class="stars">
                        ★★★★★
                        <span>Đã bán 48</span>
                    </div>

                    <strong class="side-price">
                        28.990.000 ₫
                    </strong>

                    <button class="blue-button">
                        Xem thêm
                    </button>

                </div>


                <div class="sponsor-card">

                    <div class="sponsor-label">
                        Tài trợ
                    </div>

                    <div class="side-image">

                        <img src="LINK_ANH_TAI_TRO_3"
                             alt="iPhone" />

                    </div>

                </div>

            </aside>


            <!-- ================= CONTENT ================= -->

            <main class="content">


                <!-- TIÊU ĐỀ + BANNER -->

                <section class="hero">

                    <div class="hero-left">

                        <h1>
                            Điện Thoại - Máy Tính Bảng
                        </h1>

                        <div class="iphone-promotion">

                            <div class="authorized">

                                <div class="apple">
                                    ●
                                </div>

                                <div>
                                    <b>Authorized</b>
                                    <br />
                                    <b>Reseller</b>
                                </div>

                            </div>

                            <div class="promotion-info">

                                <h2>
                                    Mở bán chính thức iPhone16 Series
                                </h2>

                                <p>
                                    Tài trợ bởi Tiki Trading 5/5 ⭐
                                </p>

                                <div class="mini-banner">

                                    <span>
                                        TIKI
                                        <br />
                                        iPhone 16 Pro
                                    </span>

                                    <img src="LINK_ANH_IPHONE_BANNER"
                                         alt="iPhone Banner" />

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- BANNER LỚN -->

                    <div class="main-banner">

                        <img src="LINK_ANH_BANNER"
                             alt="Điện thoại hiệu dưới 5 triệu" />

                    </div>

                </section>


                <!-- ================= CATEGORY ================= -->

                <section class="categories">

                    <h2>
                        Khám phá theo danh mục
                    </h2>

                    <div class="category-list">


                        <div class="category">

                            <img src="LINK_ANH_CATEGORY_1"
                                 alt="Điện thoại Smartphone" />

                            <span>
                                Điện thoại Smartphone
                            </span>

                        </div>


                        <div class="category">

                            <img src="LINK_ANH_CATEGORY_2"
                                 alt="Máy tính bảng" />

                            <span>
                                Máy tính bảng
                            </span>

                        </div>


                        <div class="category">

                            <img src="LINK_ANH_CATEGORY_3"
                                 alt="Máy đọc sách" />

                            <span>
                                Máy đọc sách
                            </span>

                        </div>


                        <div class="category">

                            <img src="LINK_ANH_CATEGORY_4"
                                 alt="Điện thoại phổ thông" />

                            <span>
                                Điện thoại phổ thông
                            </span>

                        </div>


                        <div class="category">

                            <img src="LINK_ANH_CATEGORY_5"
                                 alt="Điện thoại bàn" />

                            <span>
                                Điện thoại bàn
                            </span>

                        </div>

                    </div>

                </section>


                <!-- ================= PRODUCT ================= -->

                <section class="products">

                    <h2>
                        Tất cả sản phẩm
                    </h2>


                    <!-- FILTER -->

                    <div class="filter-row">

                        <div class="filter">

                            <label>ROM</label>

                            <button>128GB</button>
                            <button>256GB</button>
                            <button>64GB</button>
                            <button>32GB</button>
                            <button>⌄</button>

                        </div>


                        <div class="filter">

                            <label>Thương hiệu</label>

                            <button>Samsung</button>
                            <button>Xiaomi</button>
                            <button>OPPO</button>
                            <button>Panasonic</button>
                            <button>⌄</button>

                        </div>


                        <div class="filter">

                            <label>Camera sau</label>

                            <button>Trên 16MP</button>
                            <button>Từ 11MP</button>

                        </div>


                        <button class="filter-all">
                            ⚱ Tất cả
                        </button>

                    </div>


                    <!-- TAG -->

                    <div class="tags">

                        <span class="tag-new">
                            NEW
                        </span>

                        <span>
                            Giao siêu tốc 2H
                        </span>

                        <span class="tag-deal">
                            TOP DEAL
                        </span>

                        <span>
                            Siêu rẻ
                        </span>

                        <span class="tag-free">
                            FREESHIP XTRA
                        </span>

                        <span>
                            ⭐⭐⭐⭐⭐ từ 4 sao
                        </span>

                        <div class="sort">

                            <span>
                                Sắp xếp
                            </span>

                            <select id="sortSelect">

                                <option>
                                    Phổ biến
                                </option>

                                <option>
                                    Giá thấp đến cao
                                </option>

                                <option>
                                    Giá cao đến thấp
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- ================= PRODUCT GRID ================= -->

                    <div class="product-grid">


                        <!-- PRODUCT 1 -->

                        <div class="product">

                            <small class="ad">
                                AD
                            </small>

                            <img src="LINK_ANH_SAN_PHAM_1"
                                 alt="iPhone 16 Pro Max" />

                            <div class="product-badges">

                                <span>
                                    FREESHIP XTRA
                                </span>

                                <span>
                                    CHÍNH HÃNG
                                </span>

                                <span>
                                    TIKI
                                </span>

                            </div>

                            <small>
                                APPLE
                            </small>

                            <h3>
                                Apple iPhone 16 Pro Max
                            </h3>

                            <div class="product-rating">
                                ★★★★★
                                <span>
                                    Đã bán 95
                                </span>
                            </div>

                            <p>
                                1 Màu sắc |
                                1 Dung lượng
                            </p>

                            <div class="delivery">
                                <b>NEW</b>
                                Giao siêu tốc 2h
                            </div>

                            <div class="price">
                                40.990.000 ₫
                            </div>

                        </div>


                        <!-- PRODUCT 2 -->

                        <div class="product">

                            <small class="ad">
                                AD
                            </small>

                            <img src="LINK_ANH_SAN_PHAM_2"
                                 alt="iPhone 16 Pro" />

                            <div class="product-badges">

                                <span>
                                    FREESHIP XTRA
                                </span>

                                <span>
                                    CHÍNH HÃNG
                                </span>

                                <span>
                                    TIKI
                                </span>

                            </div>

                            <small>
                                APPLE
                            </small>

                            <h3>
                                Apple iPhone 16 Pro
                            </h3>

                            <div class="product-rating">
                                ★★★★★
                                <span>
                                    Đã bán 48
                                </span>
                            </div>

                            <p>
                                2 Màu sắc |
                                2 Dung lượng
                            </p>

                            <div class="delivery">
                                <b>NEW</b>
                                Giao siêu tốc 2h
                            </div>

                            <div class="price">
                                31.990.000 ₫
                            </div>

                        </div>


                        <!-- PRODUCT 3 -->

                        <div class="product">

                            <small class="ad">
                                AD
                            </small>

                            <img src="LINK_ANH_SAN_PHAM_3"
                                 alt="iPhone 16" />

                            <div class="product-badges">

                                <span>
                                    FREESHIP XTRA
                                </span>

                                <span>
                                    CHÍNH HÃNG
                                </span>

                                <span>
                                    TIKI
                                </span>

                            </div>

                            <small>
                                APPLE
                            </small>

                            <h3>
                                Apple iPhone 16 -
                                Xanh Mòng Két - 256GB
                            </h3>

                            <div class="product-rating">
                                ★★★★★
                                <span>
                                    Đã bán 15
                                </span>
                            </div>

                            <p>
                                5 Màu sắc |
                                2 Dung lượng
                            </p>

                            <div class="delivery">
                                <b>NEW</b>
                                Giao siêu tốc 2h
                            </div>

                            <div class="price red">
                                25.490.000 ₫
                                <small>-2%</small>
                            </div>

                        </div>


                        <!-- PRODUCT 4 -->

                        <div class="product">

                            <small class="ad">
                                AD
                            </small>

                            <img src="LINK_ANH_SAN_PHAM_4"
                                 alt="iPhone 16 Plus" />

                            <div class="product-badges">

                                <span>
                                    FREESHIP XTRA
                                </span>

                                <span>
                                    CHÍNH HÃNG
                                </span>

                                <span>
                                    TIKI
                                </span>

                            </div>

                            <small>
                                APPLE
                            </small>

                            <h3>
                                Apple iPhone 16 Plus
                            </h3>

                            <div class="product-rating">
                                ★★★★★
                                <span>
                                    Đã bán 12
                                </span>
                            </div>

                            <p>
                                3 Màu sắc |
                                2 Dung lượng
                            </p>

                            <div class="delivery">
                                <b>NEW</b>
                                Giao siêu tốc 2h
                            </div>

                            <div class="price">
                                25.990.000 ₫
                            </div>

                        </div>

                    </div>

