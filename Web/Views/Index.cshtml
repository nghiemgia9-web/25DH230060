@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Điện Thoại - Máy Tính Bảng | Tiki</title>

    <link rel="stylesheet" href="@Url.Content("~/Content/Style.css")" />
</head>

<body>

