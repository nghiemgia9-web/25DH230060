@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Điện Thoại - Máy Tính Bảng</title>

    <link rel="stylesheet"
          href="@Url.Content("~/Content/style.css")" />

</head>


<body>



    <header class="header">

        <div class="header-top">

            <div class="logo">
                TIKI
            </div>


            <div class="search-box">

                <span class="search-icon">
                    🔍
                </span>

                <input type="text"
                       id="searchInput"
                       placeholder="Tìm kiếm sản phẩm..." />

                <button type="button"
                        onclick="searchProduct()">

                    Tìm kiếm

                </button>

            </div>


            <div class="header-item">

                👤

                <div>
                    <small>Tài khoản</small>
                    <b>Đăng nhập</b>
                </div>

            </div>


            <div class="header-item">

                📍

                <div>
                    <small>Giao đến</small>
                    <b>Hồ Chí Minh</b>
                </div>

            </div>


            <div class="cart">

                🛒

                <span>0</span>

            </div>

        </div>


        <div class="header-menu">

            <span>Cam kết</span>

            <span>100% hàng thật</span>

            <span>Hoàn 200% nếu hàng giả</span>

            <span>30 ngày đổi trả</span>

            <span>Giao nhanh 2h</span>

            <span>Giá siêu rẻ</span>

            <span>Freeship mọi đơn</span>

        </div>

    </header>





    <main class="container">


        <div class="breadcrumb">

            Trang chủ

            <span>›</span>

            Điện Thoại - Máy Tính Bảng

        </div>



        <div class="main-layout">




            <aside class="sidebar">

                <h3>
                    Khám phá theo danh mục
                </h3>


                <a>
                    Điện thoại Smartphone
                </a>

                <a>
                    Máy tính bảng
                </a>

                <a>
                    Máy đọc sách
                </a>

                <a>
                    Điện thoại phổ thông
                </a>

                <a>
                    Điện thoại bàn
                </a>



                <h3 class="sidebar-title">
                    Thương hiệu
                </h3>


                <label>
                    <input type="checkbox">
                    Apple
                </label>


                <label>
                    <input type="checkbox">
                    Samsung
                </label>


                <label>
                    <input type="checkbox">
                    Xiaomi
                </label>


                <label>
                    <input type="checkbox">
                    OPPO
                </label>


                <label>
                    <input type="checkbox">
                    Vivo
                </label>



                <h3 class="sidebar-title">
                    Mức giá
                </h3>


                <label>
                    <input type="checkbox">
                    Dưới 5 triệu
                </label>


                <label>
                    <input type="checkbox">
                    5 - 10 triệu
                </label>


                <label>
                    <input type="checkbox">
                    10 - 20 triệu
                </label>


                <label>
                    <input type="checkbox">
                    Trên 20 triệu
                </label>

            </aside>




            <section class="content">


                <h1>
                    Điện Thoại - Máy Tính Bảng
                </h1>




                <div class="banner">


                    <div class="banner-text">

                        <p>
                            ĐIỆN THOẠI HIỆU
                        </p>

                        <h2>
                            DƯỚI 5 TRIỆU
                        </h2>

                        <span>
                            Giao nhanh 2h
                        </span>

                    </div>



                    <div class="banner-phones">

                        <div class="banner-phone black"></div>

                        <div class="banner-phone blue"></div>

                        <div class="banner-phone white"></div>

                        <div class="banner-phone green"></div>

                    </div>

                </div>




                <div class="category-box">

                    <h2>
                        Khám phá theo danh mục
                    </h2>


                    <div class="categories">


                        <div class="category">

                            <div class="category-icon">
                                📱
                            </div>

                            <p>
                                Điện thoại Smartphone
                            </p>

                        </div>



                        <div class="category">

                            <div class="category-icon">
                                💻
                            </div>

                            <p>
                                Máy tính bảng
                            </p>

                        </div>



                        <div class="category">

                            <div class="category-icon">
                                📖
                            </div>

                            <p>
                                Máy đọc sách
                            </p>

                        </div>



                        <div class="category">

                            <div class="category-icon">
                                📞
                            </div>

                            <p>
                                Điện thoại phổ thông
                            </p>

                        </div>



                        <div class="category">

                            <div class="category-icon">
                                ☎️
                            </div>

                            <p>
                                Điện thoại bàn
                            </p>

                        </div>


                    </div>

                </div>





                <div class="filter-box">

                    <h2>
                        Tất cả sản phẩm
                    </h2>


                    <div class="filter-row">

                        <strong>
                            ROM:
                        </strong>


                        <button>
                            128GB
                        </button>

                        <button>
                            256GB
                        </button>

                        <button>
                            512GB
                        </button>

                        <button>
                            1TB
                        </button>

                    </div>



                    <div class="filter-row">

                        <strong>
                            Thương hiệu:
                        </strong>


                        <button>
                            Apple
                        </button>

                        <button>
                            Samsung
                        </button>

                        <button>
                            Xiaomi
                        </button>

                        <button>
                            OPPO
                        </button>

                    </div>

                </div>


                <div class="sort-box">

                    <span class="active">
                        Phổ biến
                    </span>

                    <span>
                        Bán chạy
                    </span>

                    <span>
                        Giá thấp
                    </span>

                    <span>
                        Giá cao
                    </span>

                </div>



                <div class="products"
                     id="productList">


                    <div class="product"
                         data-name="Apple iPhone 16 Pro Max">

                        <div class="product-image">

                            <div class="phone black">

                                <div class="camera"></div>

                            </div>

                        </div>


                        <div class="product-info">

                            <small>
                                APPLE
                            </small>


                            <h3>
                                Apple iPhone 16 Pro Max -
                                Titan Tự Nhiên - 512GB
                            </h3>


                            <div class="rating">

                                ⭐⭐⭐⭐⭐

                                <span>
                                    Đã bán 58
                                </span>

                            </div>


                            <div class="price">
                                40.990.000đ
                            </div>


                            <p class="shipping">
                                🚚 Giao siêu tốc 2h
                            </p>

                        </div>

                    </div>





                    <div class="product"
                         data-name="Apple iPhone 16 Pro">

                        <div class="product-image">

                            <div class="phone blue">

                                <div class="camera"></div>

                            </div>

                        </div>


                        <div class="product-info">

                            <small>
                                APPLE
                            </small>


                            <h3>
                                Apple iPhone 16 Pro -
                                Titan Đen - 256GB
                            </h3>


                            <div class="rating">

                                ⭐⭐⭐⭐⭐

                                <span>
                                    Đã bán 46
                                </span>

                            </div>


                            <div class="price">
                                31.990.000đ
                            </div>


                            <p class="shipping">
                                🚚 Giao siêu tốc 2h
                            </p>

                        </div>

                    </div>



                    <div class="product"
                         data-name="Apple iPhone 16">

                        <div class="product-image">

                            <div class="phone green">

                                <div class="camera"></div>

                            </div>

                        </div>


                        <div class="product-info">

                            <small>
                                APPLE
                            </small>


                            <h3>
                                Apple iPhone 16 -
                                Xanh Mòng Két - 256GB
                            </h3>


                            <div class="rating">

                                ⭐⭐⭐⭐⭐

                                <span>
                                    Đã bán 15
                                </span>

                            </div>


                            <div class="price">
                                25.490.000đ

                                <em>
                                    -2%
                                </em>

                            </div>


                            <p class="shipping">
                                🚚 Giao siêu tốc 2h
                            </p>

                        </div>

                    </div>



                    <div class="product"
                         data-name="Apple iPhone 16 Plus">

                        <div class="product-image">

                            <div class="phone purple">

                                <div class="camera"></div>

                            </div>

                        </div>


                        <div class="product-info">

                            <small>
                                APPLE
                            </small>


                            <h3>
                                Apple iPhone 16 Plus -
                                Xanh Dương - 128GB
                            </h3>


                            <div class="rating">

                                ⭐⭐⭐⭐⭐

                                <span>
                                    Đã bán 12
                                </span>

                            </div>


                            <div class="price">
                                25.990.000đ
                            </div>


                            <p class="shipping">
                                🚚 Giao siêu tốc 2h
                            </p>

                        </div>

                    </div>



                    <div class="product"
                         data-name="Apple iPhone 16 Hồng">

                        <div class="product-image">

                            <div class="phone pink">

                                <div class="camera"></div>

                            </div>

                        </div>


                        <div class="product-info">

                            <small>
                                APPLE
                            </small>


                            <h3>
                                Apple iPhone 16 -
                                Hồng - 128GB
                            </h3>


                            <div class="rating">

                                ⭐⭐⭐⭐⭐

                                <span>
                                    Đã bán 32
                                </span>

                            </div>


                            <div class="price">
                                22.990.000đ
                            </div>


                            <p class="shipping">
                                🚚 Giao siêu tốc 2h
                            </p>

                        </div>

                    </div>




                    <div class="product"
                         data-name="Samsung Galaxy S25 Ultra">

                        <div class="product-image">

                            <div class="phone black">

                                <div class="camera"></div>

                            </div>

                        </div>


                        <div class="product-info">

                            <small>
                                SAMSUNG
                            </small>


                            <h3>
                                Samsung Galaxy S25 Ultra
                                5G - 256GB
                            </h3>


                            <div class="rating">

                                ⭐⭐⭐⭐⭐

                                <span>
                                    Đã bán 27
                                </span>

                            </div>


                            <div class="price">
                                29.990.000đ
                            </div>


                            <p class="shipping">
                                🚚 Giao siêu tốc 2h
                            </p>

                        </div>

                    </div>




                    <div class="product"
                         data-name="Xiaomi 14T Pro">

                        <div class="product-image">

                            <div class="phone green">

                                <div class="camera"></div>

                            </div>

                        </div>


                        <div class="product-info">

                            <small>
                                XIAOMI
                            </small>


                            <h3>
                                Xiaomi 14T Pro 5G -
                                512GB
                            </h3>


                            <div class="rating">

                                ⭐⭐⭐⭐⭐

                                <span>
                                    Đã bán 19
                                </span>

                            </div>


                            <div class="price">
                                16.990.000đ
                            </div>


                            <p class="shipping">
                                🚚 Giao siêu tốc 2h
                            </p>

                        </div>

                    </div>




                    <div class="product"
                         data-name="OPPO Reno 13">

                        <div class="product-image">

                            <div class="phone blue">

                                <div class="camera"></div>

                            </div>

                        </div>


                        <div class="product-info">

                            <small>
                                OPPO
                            </small>


                            <h3>
                                OPPO Reno 13 5G -
                                256GB
                            </h3>


                            <div class="rating">

                                ⭐⭐⭐⭐⭐

                                <span>
                                    Đã bán 24
                                </span>

                            </div>


                            <div class="price">
                                12.990.000đ
                            </div>


                            <p class="shipping">
                                🚚 Giao siêu tốc 2h
                            </p>

                        </div>

                    </div>


                </div>

            </section>

        </div>

    </main>



    <script src="@Url.Content("~/Scripts/script.js")"></script>

</body>

</html>k co